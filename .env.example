# PostgreSQL。Docker Compose 会覆盖为 postgres 服务；本地后端开发使用此值。
DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench

# 企业数据源
TIANYANCHA_BASE_URL=https://capi.tianyancha.com

# YMICP：
# - 本地开发：http://127.0.0.1:16181
# - ymicp 已连接 asset-workbench_default 网络：http://ymicp:16181
MIIT_API_URL=http://ymicp:16181
ICP_PROXY_CONTROL_TOKEN=asset-workbench-local
ICP_COMPANY_MAX_ATTEMPTS=3
ICP_COMPANY_RETRY_BACKOFF_SECONDS=2
# 仅复用数量校验完整、算法版本一致且未过期的企业级 ICP 快照。
ICP_CACHE_ENABLED=true
ICP_CACHE_TTL_HOURS=24
# 明确查询成功且总数为 0 时使用更短缓存，失败/超时不会写入缓存。
ICP_ZERO_CACHE_TTL_HOURS=6
# ICP 自动扩容：默认以 5 分钟目标和每节点 160 家企业的保守容量估算，最多 8 个大陆云函数节点。
ICP_TARGET_SECONDS=300
ICP_AUTO_SCALE_MAX_NODES=8
ICP_AUTO_SCALE_COMPANIES_PER_NODE=160
ICP_AUTO_SCALE_REGIONS=cn-hangzhou,cn-shanghai,cn-beijing,cn-shenzhen,cn-qingdao,cn-zhangjiakou,cn-huhehaote
ICP_AUTO_SCALE_EXCLUDED_REGIONS=cn-chengdu

# Worker
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=120
WORKER_CONCURRENCY=2
SUBDOMAIN_WORKER_CONCURRENCY=2

# SeaMoon。本地开发可使用 127.0.0.1；Compose 内会覆盖为 seamoon-gateway。
SERVERLESS_PROXY_URL=http://127.0.0.1:19080
SERVERLESS_PROXY_ADMIN_URL=http://127.0.0.1:19081
SERVERLESS_PROXY_MIIT_URL=http://seamoon-gateway:19080
SEAMOON_CORE_BINARY=/usr/local/bin/seamoon-core
